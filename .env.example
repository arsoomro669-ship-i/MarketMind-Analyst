# GROQ_API_KEY: Optional API key for live Groq LLaMA-3 Global Engine (Gate B).
# If not supplied or rate limited, the application automatically uses high-fidelity simulation templates.
GROQ_API_KEY=""

# GEMINI_API_KEY: Required for Gemini AI API calls if used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
